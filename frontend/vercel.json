{
  "cleanUrls": true,
  "redirects": [
    { "source": "/videos", "destination": "https://www.youtube.com/@shraddhainstudio", "permanent": true }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
